Algoritmo Ahorro
	Definir deposito, totalAhorrado Como Real
	
	totalAhorrado <- 0
	
	Mientras totalAhorrado < 800 Hacer
		Escribir "Ingrese el dinero que desea ahorrar:"
		Leer deposito
		
		totalAhorrado <- totalAhorrado + deposito
		
	FinMientras
	
	Escribir "Felicitaciones, Ha alcanzado la meta de ahorro!"
	
FinAlgoritmo
